# GateAdmin replica settings. Copy to .env and fill in. Never commit .env.
PORT=9105
HOST=0.0.0.0
# The demo login. The operator stores the same pair for Aperture as WICKET_CREDS_REPLICA="user:password".
REPLICA_USER=manager
REPLICA_PASSWORD=choose-a-long-random-value
# Owner-only routes (/owner/state, /owner/reset, /owner/hang) need this in the X-Owner-Token header. Unset = routes off.
REPLICA_OWNER_TOKEN=choose-another-long-random-value
# Idle timeout in minutes. 0 = off.
REPLICA_IDLE_MINUTES=0
